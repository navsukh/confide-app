+//
+// DOB is collected as separate day/month/year fields rather than one
+// free-text field. A single field that claims to accept "any format" is
+// genuinely ambiguous — "03-04-1990" means a different date depending on
+// whether it's read as dd-mm-yyyy or mm-dd-yyyy — and silently guessing
+// wrong on an 18+ gate has real consequences. Separate fields sidestep the
+// ambiguity instead of trying to resolve it.
+function toIsoDate(day: string, month: string, year: string): string | null {
+  const d = Number(day);
+  const m = Number(month);
+  const y = Number(year);
+  if (!day || !month || !year) return null;
+  if (!Number.isInteger(d) || !Number.isInteger(m) || !Number.isInteger(y)) return null;
+  if (m < 1 || m > 12 || d < 1 || d > 31 || y < 1900 || y > new Date().getFullYear()) return null;
+
+  // Reject impossible dates (e.g. Feb 30) rather than silently normalizing
+  // them to a nearby real date, since JS Date's rollover behavior would
+  // otherwise turn a typo into a different, wrong date of birth.
+  const date = new Date(Date.UTC(y, m - 1, d));
+  if (date.getUTCFullYear() !== y || date.getUTCMonth() !== m - 1 || date.getUTCDate() !== d) {
+    return null;
+  }
+
+  return `${String(y).padStart(4, "0")}-${String(m).padStart(2, "0")}-${String(d).padStart(2, "0")}`;
+}
