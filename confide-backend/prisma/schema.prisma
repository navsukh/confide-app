// Confide — Phase 1 conceptual data model, implemented in Prisma.
// Mirrors Section 4 of 01-architecture-overview.md.
// NOTE: this is a starting point for schema review, not a final migration-ready
// spec — confirm field-level details (e.g. exact enum values, indexes for your
// expected query patterns) before running this against a shared environment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SubscriptionTier {
  SILVER
  GOLD
  DIAMOND
  PLATINUM
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  UNSPECIFIED
}

enum MatchRole {
  SPEAKER
  LISTENER
}

enum MatchRequestState {
  QUEUED
  MATCHED
  EXPIRED
  CANCELLED
}

enum ConversationStatus {
  ACTIVE
  ENDED
  CRISIS_ROUTED
}

enum ModerationAction {
  ALLOW
  WARN
  BLOCK
  BLOCK_AND_ESCALATE
}

enum ReportReason {
  HARASSMENT
  SEXUAL_CONTENT
  SELF_HARM_DISCLOSURE
  SPAM
  UNDERAGE_SUSPECTED
  OTHER
}

model User {
  id                String        @id @default(cuid())
  displayHandle     String        @unique // anonymized, never a real name
  dob               DateTime      // verification only — never returned to clients
  phoneE164         String        @unique // verification only — never returned to clients
  phoneVerifiedAt    DateTime?
  gender            Gender        @default(UNSPECIFIED)
  region            String? // ISO country/region code, used for matching + crisis routing
  languages         String[]      @default([])
  accountStatus     AccountStatus @default(ACTIVE)

  // Coarse location for spatial matching (Phase 3 feature, now implemented).
  // Store only what's needed for distance calculation — city/region-level
  // precision is enough and reduces privacy exposure vs. exact GPS. Round
  // client-side before sending if you want an extra privacy margin.
  latitude          Float?
  longitude         Float?

  expoPushToken     String?  // for match-found / message notifications while backgrounded

  // One-time free trial (10-min, SILVER-tier-only conversation) — see
  // routes/trial.ts. Set the instant a trial MatchRequest is created, not
  // when it completes, so cancel-and-retry can't be used to get a second
  // trial.
  freeTrialUsedAt   DateTime?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  subscription      Subscription?
  listenerProfile   ListenerProfile?
  matchRequests     MatchRequest[]
  sentMessages      Message[]         @relation("MessageSender")
  reportsFiled      Report[]          @relation("ReportingUser")
  reportsReceived   Report[]          @relation("ReportedUser")
  conversationsAsA  Conversation[]    @relation("ConversationParticipantA")
  conversationsAsB  Conversation[]    @relation("ConversationParticipantB")
  pointLedgerEntries PointLedgerEntry[]
  journalEntries    JournalEntry[]
  moodEntries       MoodEntry[]

  @@index([accountStatus])
}

model ListenerProfile {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id])

  level                 Int      @default(1) // 1-4, 100 points/level per Section 1
  points                Int      @default(0)
  totalSessions         Int      @default(0)
  avgRating             Float?   // derived from post-chat ratings only (no AI "advice quality" scoring — see Section 1.1)
  priorityEligible       Boolean  @default(false)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Subscription {
  id               String           @id @default(cuid())
  userId           String           @unique
  user             User             @relation(fields: [userId], references: [id])

  tier             SubscriptionTier
  stripeSubId      String?          @unique
  status           String           // mirror Stripe's status values; keep as string, don't re-invent an enum that drifts from Stripe
  renewsAt         DateTime?

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model MatchRequest {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id])

  role           MatchRole
  topicTag       String
  genderPref     Gender?
  radiusMinKm    Int?
  radiusMaxKm    Int?
  languagePref   String?
  state          MatchRequestState  @default(QUEUED)

  // Free-trial requests are always matched at SILVER tier regardless of the
  // requester's real subscription tier (they typically have none yet) — see
  // workers/matching.worker.ts. Real (non-trial) requests can only be
  // created by a user with an active subscription — enforced in
  // routes/match.ts, not just assumed here.
  isTrial        Boolean            @default(false)

  matchedConversationId String?

  createdAt      DateTime           @default(now())
  expiresAt      DateTime

  @@index([state, role, topicTag])
}

model Conversation {
  id             String             @id @default(cuid())

  participantAId String
  participantA   User               @relation("ConversationParticipantA", fields: [participantAId], references: [id])
  participantBId String
  participantB   User               @relation("ConversationParticipantB", fields: [participantBId], references: [id])

  topicTag       String
  status         ConversationStatus @default(ACTIVE)

  // Free-trial conversations are hard-capped server-side (routes/chat.ts
  // schedules an auto-close at trialEndsAt) — this is enforcement, not just
  // a client-side countdown display value.
  isTrial        Boolean            @default(false)
  trialEndsAt    DateTime?

  startedAt      DateTime           @default(now())
  endedAt        DateTime?

  messages       Message[]
  rating         Rating?

  @@index([status])
}

model Message {
  id                 String            @id @default(cuid())
  conversationId     String
  conversation       Conversation      @relation(fields: [conversationId], references: [id])
  senderId           String
  sender             User              @relation("MessageSender", fields: [senderId], references: [id])

  // Plaintext is only ever stored for ALLOWED messages. Blocked content is
  // handled per Section 7.2 — see ModerationEvent, which stores a hash, not
  // plaintext, for anything blocked/escalated.
  content            String?
  moderationAction   ModerationAction  @default(ALLOW)

  sentAt             DateTime?
  blockedAt          DateTime?

  moderationEvent    ModerationEvent?

  @@index([conversationId, sentAt])
}

model ModerationEvent {
  id             String            @id @default(cuid())
  messageId      String            @unique
  message        Message           @relation(fields: [messageId], references: [id])

  contentHash    String            // SHA-256 of the raw content; never the plaintext itself by default
  category       String            // e.g. "self-harm", "sexual-content", "harassment"
  verdict        ModerationAction
  modelName      String
  modelVersion   String

  // Section 7.2 escalation bucket: only populated for content specifically
  // escalated for safety review (credible threat, exploitation disclosure).
  // AES-256-GCM ciphertext (see lib/encryption.ts) — genuinely encrypted at
  // the application layer now, not just "encrypted at rest" by whichever
  // host's disk happens to be. Every decrypt (see routes/admin.ts) writes
  // an AccessAuditLog row.
  escalatedCiphertext  String?
  escalatedRetainUntil DateTime?

  createdAt      DateTime          @default(now())
}

// Section 7.2's "access must be logged" requirement, implemented as an
// append-only table rather than relying on an external log sink — free-tier
// friendly (no extra service dependency) and portable to any Postgres host.
// If you later wire this into Datadog/CloudWatch/etc., keep writing here
// too; a DB-native audit trail survives even if the external sink has an
// outage or gets misconfigured.
model AccessAuditLog {
  id              String   @id @default(cuid())
  actor           String   // e.g. "admin" — see routes/admin.ts note on the shared-token limitation
  action          String   // e.g. "decrypt_escalated_content"
  resourceType    String   // e.g. "ModerationEvent"
  resourceId      String
  createdAt       DateTime @default(now())

  @@index([resourceType, resourceId])
}

model Rating {
  id             String       @id @default(cuid())
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  score          Int          // 1-5
  comment        String?

  createdAt      DateTime     @default(now())
}

model Report {
  id               String       @id @default(cuid())
  reportingUserId  String
  reportingUser    User         @relation("ReportingUser", fields: [reportingUserId], references: [id])
  reportedUserId   String
  reportedUser     User         @relation("ReportedUser", fields: [reportedUserId], references: [id])
  conversationId   String?

  reason           ReportReason
  details          String?
  resolved         Boolean      @default(false)

  createdAt        DateTime     @default(now())

  @@index([reportedUserId])
}

// Section 1's "100 points/level" leveling, implemented as an append-only
// ledger rather than just incrementing a counter — makes it possible to
// audit/reverse a bad grant (e.g. a rating later found to be retaliatory)
// without losing history.
model PointLedgerEntry {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  conversationId String?
  points         Int      // can be negative (e.g. a reversal)
  reason         String   // e.g. "session-completed", "five-star-rating", "reversal"
  createdAt      DateTime @default(now())

  @@index([userId])
}

model Block {
  id             String   @id @default(cuid())
  blockerUserId  String
  blockedUserId  String
  createdAt      DateTime @default(now())

  @@unique([blockerUserId, blockedUserId])
}

// Wellness features — gated behind an active subscription (see
// lib/subscription.ts), same as real matching. Entries are private to the
// user; nothing here is shared with a match partner or moderated, since
// it's reflective content, not chat.
model JournalEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  content   String
  mood      String? // free-form tag, e.g. "anxious", "hopeful" — not the same enum as MoodEntry's fixed scale

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  // Fixed 1-5 scale rather than free text, so trends can actually be
  // charted — free-form mood descriptions live on JournalEntry instead.
  score     Int      // 1 (very low) – 5 (very good)
  note      String?

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
