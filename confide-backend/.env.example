# Postgres — source of truth for everything except queues/presence (Section 3)
DATABASE_URL="postgresql://user:password@localhost:5432/confide"

# Redis — queues, presence, chat pub/sub. Ephemeral by design.
REDIS_URL="redis://localhost:6379"

# Server
PORT=3000
JWT_SECRET="change-me-to-a-long-random-string"

# Moderation — hosted API, per Section 2/6
MODERATION_PROVIDER=openai
OPENAI_API_KEY=""
MODERATION_TIMEOUT_MS=2500

# Matching
MATCH_REQUEST_TTL_SECONDS=120

# Stripe — https://dashboard.stripe.com/apikeys and /products for Price IDs
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_PRICE_SILVER=""
STRIPE_PRICE_GOLD=""
STRIPE_PRICE_DIAMOND=""
STRIPE_PRICE_PLATINUM=""

# Admin dashboard (shared-secret gate — see routes/admin.ts note on limits)
ADMIN_TOKEN="change-me-to-a-long-random-string"

# Push notifications — only needed if you enable Expo's push security feature
EXPO_ACCESS_TOKEN=""

# Escalated-content encryption — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ESCALATION_ENCRYPTION_KEY=""

# Monitoring — free tier at sentry.io covers 5k errors/month. Leave blank to disable.
SENTRY_DSN=""
